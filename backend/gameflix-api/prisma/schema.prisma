generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tabela de Usuários (para autenticação)
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

// Tabela do Catálogo de Jogos
model Game {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
}

// Tabela de Inscrições na Newsletter
model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}