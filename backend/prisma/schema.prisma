generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inscrito {
  id    String @id @default(uuid())
  email String @unique
}

model Categoria {
  id    String @id @default(uuid())
  nome  String
  jogos Jogo[]
}

model Jogo {
  id          String    @id @default(uuid())
  titulo      String
  descricao   String?
  ano         Int?
  capaUrl     String?
  
  // Configuração do Relacionamento com Categoria (Sem o ObjectId!)
  categoriaId String    
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
}

model Usuario {
  id    String @id @default(uuid())
  nome  String
  email String @unique
  senha String
}